# Copy to .env (./setup.sh does this and fills the secrets). Never commit .env.

# --- filled in by ./setup.sh ------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
QUILLQUEST_SESSION_SECRET=
QUILLQUEST_PROXY_SECRET=

# --- you fill these in ------------------------------------------------------------------------------------------------
# A Tailscale auth key (https://login.tailscale.com/admin/settings/keys). A reusable key is easiest.
TS_AUTHKEY=
# The machine name on your tailnet; the address becomes https://<name>.<your-tailnet>.ts.net
TS_HOSTNAME=quillquest
# Who may sign in: a comma-separated list of the Tailscale logins (emails) of you and your friends.
# Empty means anyone who can reach the machine over your tailnet.
QUILLQUEST_TAILNET_ALLOW=

# --- optional ---------------------------------------------------------------------------------------------------------
# The address links in emails start from.
QUILLQUEST_PUBLIC_URL=

# Supabase sign-in beside Tailscale (leave all four empty to use Tailscale only). The two NEXT_PUBLIC_ values are baked
# into the web image, so rebuild with `docker compose up -d --build` after changing them.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Claude assistant. QUILLQUEST_LLM is anthropic or openai-compat; see docs/llm-providers.md.
QUILLQUEST_LLM=
QUILLQUEST_LLM_MODEL=
QUILLQUEST_LLM_URL=
QUILLQUEST_LLM_KEY=
ANTHROPIC_API_KEY=

# Email for async play. QUILLQUEST_MAIL is resend; see docs/mail-providers.md.
QUILLQUEST_MAIL=
QUILLQUEST_MAIL_FROM=
RESEND_API_KEY=
